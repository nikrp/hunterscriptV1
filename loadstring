-- Centralized Webhook Sending Function
local function attemptWebhookSend(targetUrl, encodedPayload, notificationType)
    if not targetUrl or targetUrl == "YOUR_WEBHOOK_URL_HERE" or string.len(targetUrl) < 20 then
        warn("Webhook URL invalid for:", notificationType)
        return false
    end

    local success, response = false, "No request attempt"
    local sent = false

    -- Try 'request' first
    if request and type(request) == "function" then
        print("Attempting", notificationType, "webhook via 'request' to", targetUrl:sub(1,50).."...")
        success, response = pcall(request, { Url = targetUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        if success then
            print(notificationType, "Webhook possibly sent via 'request'.")
            sent = true -- Assume success if pcall doesn't error
        else
            warn(notificationType, "'request' failed:", response)
        end
    else
        print("'request' not found/usable for", notificationType)
    end

    -- Fallback to HttpService if 'request' failed or wasn't available
    if not sent then
        print("Falling back to HttpService for", notificationType, "webhook...")
        success, response = pcall(HttpService.RequestAsync, HttpService, { Url = targetUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        if not success then
            warn("HttpService", notificationType, "webhook failed (Likely blocked):", response)
            sent = false
        else
            print(notificationType, "Webhook sent via HttpService.")
            sent = true
        end
    end
    return sent
end



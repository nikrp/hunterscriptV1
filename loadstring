                    if not foundMultiplier then for _, pName in ipairs(PotentialMultiplierNames) do local att=island:GetAttribute(pName); if att then if type(att)=="number" then riftData.Multiplier=tostring(att).."x"; riftData.MultiplierValue=att; foundMultiplier=true; print("  - Found Multi via Attribute:", riftData.Multiplier); break elseif type(att)=="string" and att:match("^[%d%.]+x?$") then riftData.Multiplier=att; if not att:find("x",1,true) then riftData.Multiplier=att.."x" end; riftData.MultiplierValue=parseMultiplier(att); foundMultiplier=true; print("  - Found Multi via String Attribute:", riftData.Multiplier); break end end end end
                    if not foundMultiplier then for _, d in ipairs(island:GetDescendants()) do if d:IsA("TextLabel") then local txt=d.Text or ""; local lt=string.lower(txt); if lt:match("x%d") or lt:match("%dx") then riftData.Multiplier=txt; riftData.MultiplierValue=parseMultiplier(txt); foundMultiplier=true; print("  - Found potential Multi via GUI Text:", riftData.Multiplier); break end end end end


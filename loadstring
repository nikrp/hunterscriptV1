--// Logging Function
local function sendLogMessage(message, level)
    if not LogWebhookURL or LogWebhookURL == "" or string.len(LogWebhookURL) < 20 then
        if level == "WARN" or level == "ERROR" then warn("Log WARN/ERROR (Webhook N/A): " .. tostring(message))
        else print("Log INFO (Webhook N/A): " .. tostring(message)) end
        return
    end
    local playerName = Player and Player.DisplayName or "UnknownPlayer"
    local botUser = "Rift Finder Logs (" .. playerName .. ")"
    local payload = { username = botUser, content = string.format("[%s] %s", level or "INFO", tostring(message)) }
    local encodeSuccess, encodedPayload = pcall(HttpService.JSONEncode, HttpService, payload)
    if not encodeSuccess then warn("Log Send Fail (JSON Encode): " .. tostring(message)); return end

    task.spawn(function()
        local success, response = false, "No request attempt"
        if request and type(request) == "function" then
            success, response = pcall(request, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
            if not success then warn(string.format("Log Send Fail ('request'): %s | Msg: %s", tostring(response), tostring(message))) end
        elseif HttpService then
             success, response = pcall(HttpService.RequestAsync, HttpService, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
             if not success then warn(string.format("Log Send Fail (HttpService): %s | Msg: %s", tostring(response), tostring(message))) end
        else
             warn("Log Send Fail: No 'request' function or HttpService available.")
        end
    end)
end

local function sendDetailedLog(message) if ENABLE_DETAILED_LOGGING then sendLogMessage(message, "DETAIL") end end

--// Server Blacklist Setup & Persistence Functions
_G.visitedServers = _G.visitedServers or {}
local function countBlacklist() local c = 0; if _G.visitedServers then for _ in pairs(_G.visitedServers) do c = c + 1 end end; return c end

local function loadBlacklist()
    if isfile and readfile and isfile(BLACKLIST_FILENAME) then
        sendLogMessage("Attempting to load blacklist from: " .. BLACKLIST_FILENAME)
        local s_read, fContent = pcall(readfile, BLACKLIST_FILENAME)
        if s_read and fContent and type(fContent) == "string" and #fContent > 2 then
            local s_decode, loadedTable = pcall(HttpService.JSONDecode, HttpService, fContent)
            if s_decode and type(loadedTable) == "table" then
                _G.visitedServers = loadedTable
                sendLogMessage("Successfully loaded blacklist. Size: " .. countBlacklist())
            else sendLogMessage("Failed to decode blacklist JSON: " .. (s_decode and tostring(loadedTable) or "Decode Error"), "WARN"); _G.visitedServers = {} end
        else sendLogMessage("Failed to read blacklist file or file empty: " .. (s_read and "Read OK but empty/invalid" or "Read Error"), "WARN"); _G.visitedServers = {} end
    else
        if not isfile or not readfile then sendLogMessage("Executor file functions ('isfile'/'readfile') missing. Blacklist persistence disabled.", "WARN") end
        sendLogMessage("Blacklist file not found or unsupported. Initializing empty blacklist.")
        _G.visitedServers = {}
    end
    if CurrentJobId and not _G.visitedServers[CurrentJobId] then
         sendLogMessage("Adding current server to loaded/new blacklist: " .. CurrentJobId)
        _G.visitedServers[CurrentJobId] = true
    end
end

local function saveBlacklist()
    if writefile then
        sendLogMessage("Attempting to save blacklist...")
        local currentSize = countBlacklist()
        local s_encode, jsonContent = pcall(HttpService.JSONEncode, HttpService, _G.visitedServers)
        if s_encode and jsonContent then
            local s_write, writeResponse = pcall(writefile, BLACKLIST_FILENAME, jsonContent)
            if s_write then sendLogMessage("Successfully saved blacklist. Size: " .. currentSize)
            else sendLogMessage("Failed to write blacklist file: " .. tostring(writeResponse), "ERROR") end
        else sendLogMessage("Failed to JSONEncode blacklist: " .. (s_encode and "Encode OK but nil content?" or tostring(jsonContent)), "ERROR") end
    end
end


-- Generic Webhook Sender with Error Handling
local function sendWebhookPayload(url, payloadData, webhookType)
    if not url or url == "" or string.len(url) < 20 then sendLogMessage(webhookType .. " Webhook URL invalid.", "WARN"); return false end
    if not payloadData or type(payloadData) ~= "table" then sendLogMessage("Invalid payload data for " .. webhookType .. " webhook.", "ERROR"); return false end

    local encodeSuccess, encodedPayload = pcall(HttpService.JSONEncode, HttpService, payloadData)
    if not encodeSuccess then sendLogMessage("JSONEncode failed for " .. webhookType .. " webhook: " .. tostring(encodedPayload), "ERROR"); return false end

    local success, response = false, "No request attempt"
    local request_func = request -- Capture global request function

    if request_func and type(request_func) == "function" then
        sendDetailedLog("Attempting " .. webhookType .. " webhook via 'request'...")
        success, response = pcall(request_func, { Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        if success then
            sendDetailedLog(webhookType .. " Webhook possibly sent via 'request'.")
            return true -- Indicate success
        else
            sendLogMessage("'request' for " .. webhookType .. " Webhook failed: " .. tostring(response), "WARN")
            -- Don't return yet, try HttpService
        end
    else
        sendDetailedLog("'request' not found/usable for " .. webhookType .. " Webhook.")
    end

    if HttpService then
        sendDetailedLog("Falling back to HttpService for " .. webhookType .. " webhook...")
        success, response = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        if success then
             sendDetailedLog(webhookType .. " Webhook sent via HttpService.")
             return true -- Indicate success
        else
             sendLogMessage("HttpService " .. webhookType .. " webhook failed (Likely blocked): " .. tostring(response), "WARN")
             return false -- Indicate failure
        end
    else
        sendLogMessage("Cannot send " .. webhookType .. " webhook: No 'request' function or HttpService available.", "ERROR")
        return false -- Indicate failure
    end
end


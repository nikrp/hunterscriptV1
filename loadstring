-- Send Webhook Message Generic Function
local function sendWebhookGeneric(targetWebhookURL, payloadData, webhookPurpose)
    if not targetWebhookURL or string.len(targetWebhookURL) < 20 then logMessage("warn", webhookPurpose .. " Webhook URL invalid or not set."); return false end
    local encodeSuccess, encodedPayload = pcall(HttpService.JSONEncode, HttpService, payloadData); if not encodeSuccess then logMessage("warn", "JSONEncode failed for " .. webhookPurpose .. " webhook: " .. tostring(encodedPayload)); return false end
    local success, response = false, "No request attempt"; if request and type(request) == "function" then logMessage("info", "Attempting " .. webhookPurpose .. " webhook via 'request'..."); success, response = pcall(request, { Url = targetWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload }); if success then logMessage("info", webhookPurpose .. " Webhook possibly sent via 'request'."); return true else logMessage("warn", webhookPurpose .. " 'request' failed: " .. tostring(response)) end else logMessage("info", "'request' not found/usable for " .. webhookPurpose .. ".") end
    logMessage("info", "Falling back to HttpService for " .. webhookPurpose .. " webhook..."); success, response = pcall(HttpService.RequestAsync, HttpService, { Url = targetWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload }); if not success then logMessage("warn", "HttpService " .. webhookPurpose .. " webhook failed (Likely blocked): " .. tostring(response)); return false else logMessage("info", webhookPurpose .. " Webhook sent via HttpService."); return true end
end

-- Send Rift Found Notification (Handles General, Specific, and All Finds)
local function sendRiftNotification(riftData)
    local pCount = #Players:GetPlayers()
    local maxPlayers = Players.MaxPlayers
    local joinLink = string.format("roblox://experiences/start?placeId=%d&gameInstanceId=%s", PlaceId, CurrentJobId)
    local serverMsg = "JobId: " .. (CurrentJobId or "??")
    local title = riftData.DisplayName
    local imgUrl = RiftImageMapping[riftData.NameLower]
    local footerText = string.format("discord.gg/rifthunter - The best ever rift finding service | %s", os.date("!%Y-%m-%dT%H:%M:%SZ"))

    -- Format Time Remaining String
    local timeString = "Unknown"
    if riftData.TimeSeconds then
        local minutes = math.floor(riftData.TimeSeconds / 60)
        local seconds = riftData.TimeSeconds % 60
        if minutes > 0 then
            timeString = string.format("%d min %02d sec (%d s)", minutes, seconds, riftData.TimeSeconds)
        else
            timeString = string.format("%d sec", riftData.TimeSeconds)
        end
    elseif type(riftData.TimeLeft) == "string" then -- Fallback if only raw string found
        timeString = riftData.TimeLeft
    end

    local embed = {
        title = "✅ Rift Found: " .. title,
        color = 65280, -- Green color
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        fields = {
            {name="✨ Multi", value=tostring(riftData.Multiplier), inline=true},
            {name="🕒 Time Remaining", value=timeString, inline=true}, -- Updated name and format
            {name="📏 Height", value=tostring(riftData.Height), inline=true},
            {name="🧍 Players", value=string.format("%d/%d", pCount, maxPlayers), inline=true},
            {name="🆔 Server", value=serverMsg, inline=true},
            {name="🔗 Join", value=joinLink, inline=false}, -- Raw link
            {name="❓ How to use", value="Copy and paste the link above into your browser's address bar.", inline=false} -- How-to section
        },
        footer = { text = footerText }
    }
    if imgUrl and imgUrl ~= "PASTE_URL_HERE" and string.find(imgUrl, "https://") then embed.thumbnail = { url = imgUrl }; logMessage("debug", " - Added thumbnail for " .. title) else logMessage("debug", " - No valid thumbnail for " .. title) end

    local payload = { username = "discord.gg/rifthunter", embeds = { embed } } -- Set author name

    -- 1. Send to General Webhook
    logMessage("info", "Sending notification for " .. title .. " to General webhook...")
    sendWebhookGeneric(GeneralRiftWebhookURL, payload, "General Rift")

    -- 2. Send to "All Finds" Webhook
    logMessage("info", "Sending notification for " .. title .. " to All Finds webhook...")
    sendWebhookGeneric(AllFindsWebhookURL, payload, "All Finds")

    -- 3. Send to Specific Webhook (if applicable)
    local specificUrl = SpecificRiftWebhooks[riftData.NameLower]
    if specificUrl then
        logMessage("info", "Sending notification for " .. title .. " to Specific (" .. riftData.NameLower .. ") webhook...")
        sendWebhookGeneric(specificUrl, payload, "Specific Rift (" .. riftData.NameLower .. ")")
    end
end


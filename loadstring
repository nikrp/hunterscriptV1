-- Get Player Count
local function getServerPlayerCount() return #Players:GetPlayers() end

-- Function to format seconds into M:SS
local function formatSecondsToMSS(totalSeconds)
    if totalSeconds and type(totalSeconds) == "number" and totalSeconds >= 0 then
        local minutes = math.floor(totalSeconds / 60)
        local seconds = totalSeconds % 60
        return string.format("%d:%02d", minutes, seconds) -- Pad seconds with leading zero if needed
    else
        return nil -- Return nil if input is invalid
    end
end

-- Main Search and Hop Logic (Handles single found rift or nil)

        local url = fetchUrlBase .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        logMessage("debug", string.format("Fetching server page %d...", attempts))
        local success, response = pcall(request, {Url = url, Method = "GET"})
        local processPage = true

        if not success or not response or type(response) ~= "table" or not response.Body then
            logMessage("warn", string.format("Failed to fetch server list via 'request' on attempt %d. Success: %s", attempts, tostring(success)))
            processPage = false
        elseif type(response.Body) ~= "string" then
             logMessage("warn", string.format("Invalid response body type on page %d: %s. Expected string.", attempts, type(response.Body)))
             processPage = false
        end

        if processPage then
            local decodeSuccess, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
            if decodeSuccess and type(data) == "table" and data.data then
                local count = 0; for _, v in pairs(data.data) do if type(v) == "table" and v.id and v.playing and v.maxPlayers then table.insert(servers, {id = v.id, playing = v.playing, maxPlayers = v.maxPlayers}); count = count + 1 end end; logMessage("debug", string.format("Decoded page %d, added %d servers.", attempts, count))
                if data.nextPageCursor then cursor = data.nextPageCursor; logMessage("debug", "Found nextPageCursor.") else logMessage("debug", "Reached end of server list."); break end
            else
                logMessage("warn", string.format("Failed to decode server list JSON or invalid format on page %d. Decode Success: %s", attempts, tostring(decodeSuccess)))
                local bodySample = string.sub(response.Body, 1, 500)
                logMessage("warn", "Raw response body on decode error (first 500 chars): \n" .. bodySample)
                if string.find(bodySample, "Too many requests", 1, true) then
                    logMessage("warn", "RATE LIMIT DETECTED. Waiting longer before next attempt...")
                    task.wait(SERVER_FETCH_DELAY * 2)
                end
            end
        else
             task.wait(1)
             if attempts >= maxAttempts then
                 logMessage("warn", "Max fetch attempts reached after error.")
                 break
             end
        end

        logMessage("debug", string.format("Waiting %d seconds before next page fetch...", SERVER_FETCH_DELAY))
        task.wait(SERVER_FETCH_DELAY)
    end
    logMessage("info", "Finished fetching servers. Total found: " .. #servers); return servers
end

-- Attempt Teleport (Uses Blacklist, Saves Blacklist Before Hop, Clears Blacklist at Limit)
local function attemptHop(reason)
    sendHopNotification(reason)
    task.wait(1)

    local serverList = getServers()
    local targetServerId = nil

    if serverList and #serverList > 0 then
        logMessage("info", "Filtering server list (Size: " .. #serverList .. ")")
        local validServers = {}
        local currentBlacklistSize = countBlacklist()
        local skippedBlacklisted = 0
        for _, serverInfo in ipairs(serverList) do
            local isVisited = _G.visitedServers[serverInfo.id]
            if isVisited then skippedBlacklisted = skippedBlacklisted + 1 end
            if serverInfo.id ~= CurrentJobId and serverInfo.playing < serverInfo.maxPlayers and not isVisited then
                table.insert(validServers, serverInfo.id)
            end
        end
        logMessage("info", string.format("Filtering complete. Valid Servers Found: %d | Skipped (Blacklisted): %d | Current Blacklist Size: %d", #validServers, skippedBlacklisted, currentBlacklistSize))
        if #validServers > 0 then
            targetServerId = validServers[math.random(1, #validServers)]
            logMessage("info", "Selected target server JobId: " .. targetServerId)
            _G.visitedServers[targetServerId] = true
            local newSize = countBlacklist()
            logMessage("info", "Added target to blacklist. New size: " .. newSize)

            if newSize >= MAX_BLACKLIST_SIZE then
                logMessage("warn", "Blacklist limit (" .. MAX_BLACKLIST_SIZE .. ") reached! Clearing blacklist.")
                _G.visitedServers = {}
                if CurrentJobId then
                    logMessage("info", "Re-adding current server to cleared blacklist: " .. CurrentJobId)
                    _G.visitedServers[CurrentJobId] = true
                end
                logMessage("info", "Blacklist cleared. New size: " .. countBlacklist())
            end
        else
            logMessage("warn", "No valid *new* non-blacklisted servers found. Falling back to generic teleport.")
        end
    else
        logMessage("warn", "Server list empty or failed to fetch. Falling back to generic teleport.")
    end

    saveBlacklist()
    task.wait(0.5)

    local success, err
    if targetServerId then
        logMessage("info", "Attempting TeleportToPlaceInstance: " .. targetServerId)
        success, err = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, PlaceId, targetServerId, Player)
        if not success then
             if err and type(err) == "string" and string.find(err, "Unauthorized", 1, true) then
                 logMessage("warn", "TeleportToPlaceInstance failed: Unauthorized (Cannot join specific private instance). Falling back to generic join.")
             else
                 logMessage("warn", "TeleportToPlaceInstance failed: " .. tostring(err))
             end
             logMessage("info", "Hop manually or wait for generic teleport fallback...")
             task.wait(1)
             saveBlacklist()
             task.wait(0.5)
             logMessage("info", "Attempting generic Teleport...")
             local genSuccess, genErr = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
             if not genSuccess then
                 logMessage("error", "Generic Teleport also failed: " .. tostring(genErr) .. ". Hop manually & re-execute.")
             else
                 logMessage("info", "Generic Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
             end
        else
             logMessage("info", "Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
        end
    else
        logMessage("info", "Attempting generic Teleport...")
        success, err = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
        if not success then
            logMessage("error", "Generic Teleport failed: " .. tostring(err) .. ". Hop manually & re-execute.")
        else
            logMessage("info", "Generic Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
        end
    end
end

-- Parse Multiplier Text
local function parseMultiplier(multiplierText)
    if not multiplierText or type(multiplierText) ~= "string" then return nil end
    local numStr = string.match(multiplierText, "[%d%.]+")
    if numStr then return tonumber(numStr) end
    return nil
end

-- Parse Time Text (Older Method - Focus on TextLabels)
local function parseTime(timeText)
    if not timeText or type(timeText) ~= "string" then return nil end
    local totalSeconds = 0

    -- Try MM:SS format
    local min, sec = string.match(timeText, "^(%d+):(%d+)$")
    if min and sec then
        totalSeconds = tonumber(min) * 60 + tonumber(sec)
        logMessage("debug", "Parsed time '" .. timeText .. "' as MM:SS -> " .. totalSeconds .. "s")
        return totalSeconds
    end

    -- Try "X minutes Y seconds" format
    local minutes, seconds = string.match(timeText, "(%d+) ?minutes? ?(%d*) ?sec?")
    if minutes then
        totalSeconds = tonumber(minutes) * 60 + (tonumber(seconds) or 0)
        logMessage("debug", "Parsed time '" .. timeText .. "' as 'X min Y sec' -> " .. totalSeconds .. "s")
        return totalSeconds
    end

     -- Try "X minutes" format
    minutes = string.match(timeText, "(%d+) ?minutes?")
    if minutes then
        totalSeconds = tonumber(minutes) * 60
        logMessage("debug", "Parsed time '" .. timeText .. "' as 'X min' -> " .. totalSeconds .. "s")
        return totalSeconds
    end

    -- Try "X sec" format
    local secondsOnly = string.match(timeText, "(%d+) ?sec")
    if secondsOnly then
        totalSeconds = tonumber(secondsOnly)
        logMessage("debug", "Parsed time '" .. timeText .. "' as 'X sec' -> " .. totalSeconds .. "s")
        return totalSeconds
    end

    -- Fallback: Try parsing just numbers (less reliable for time)
    local numOnly = tonumber(timeText)
    if numOnly then
        logMessage("debug", "Parsed time '" .. timeText .. "' as raw number -> " .. numOnly .. "s (Assuming seconds)")
        return numOnly -- Assume it's seconds if just a number
    end

    logMessage("debug", "Could not parse time string: " .. timeText)
    return nil
end


-- Find Target Rifts (Returns a LIST of found rifts, Applies Filters, Handles "Or Above")
local function findTargetRifts()
    logMessage("info", string.format("Searching... (Filter: AnyM=%s, 5x=%s, 10x=%s, 25x=%s, OrAbove=%s, MinTime=%ds)",
        tostring(SearchMultiplierAny), tostring(SearchMultiplier5x), tostring(SearchMultiplier10x), tostring(SearchMultiplier25x), tostring(SearchMultiplierOrAbove), MINIMUM_RIFT_TIME_SECONDS))
    logMessage("debug", "Waiting for folder '"..RENDERED_FOLDER_NAME.."' in workspace...")
    local renderedFolder = workspace:WaitForChild(RENDERED_FOLDER_NAME, WAIT_FOR_FOLDERS_TIMEOUT); if not renderedFolder then logMessage("error", "'"..RENDERED_FOLDER_NAME.."' folder not found."); return {} end
    logMessage("debug", "Waiting for folder '"..TARGET_RIFTS_FOLDER_NAME.."' inside '"..RENDERED_FOLDER_NAME.."'...")
    local islandsFolder = renderedFolder:WaitForChild(TARGET_RIFTS_FOLDER_NAME, WAIT_FOR_FOLDERS_TIMEOUT); if not islandsFolder then logMessage("error", "'"..TARGET_RIFTS_FOLDER_NAME.."' folder not found."); return {} end
    logMessage("info", "Scanning folder: " .. islandsFolder:GetFullName())

    local foundRiftsList = {} -- Initialize list to store multiple finds

    for _, island in ipairs(islandsFolder:GetChildren()) do
        if not (island:IsA("Model") or island:IsA("Folder")) then continue end

        local islandName = island.Name
        local islandNameLower = string.lower(islandName)

        -- Check if this rift type is enabled in settings
        if SearchRifts[islandNameLower] then
            logMessage("debug", "Potential match found: " .. islandName .. " (Enabled in settings)")
            local displayName = RiftDisplayNameMapping[islandNameLower] or islandName
            local riftData = { Name = islandName, NameLower = islandNameLower, DisplayName = displayName, TimeLeft = "Unknown", TimeSeconds = nil, Height = "Unknown", Position = "Unknown", Multiplier = "Unknown", MultiplierValue = nil, Instance = island }
            local foundMultiplier, foundTime, foundHeight = false, false, false
            local passedMultiplierFilter = false
            local passedTimeFilter = true -- Assume passes unless proven otherwise

            -- Determine Multiplier
            if NoMultiplierTypes[islandNameLower] then
                logMessage("debug", "  - Type has no multiplier. Setting to N/A.")
                riftData.Multiplier = "N/A"; riftData.MultiplierValue = nil; foundMultiplier = true
                passedMultiplierFilter = true -- Always passes if N/A
            else
                -- Find Multiplier (Value/Attribute/TextLabel)
                for _, pName in ipairs(PotentialMultiplierNames) do local obj=island:FindFirstChild(pName,true); if obj and obj:IsA("ValueBase") then local v=obj.Value; if type(v)=="number" then riftData.Multiplier=tostring(v).."x"; riftData.MultiplierValue=v; foundMultiplier=true; logMessage("debug", "  - Found Multi via Value: "..riftData.Multiplier); break elseif type(v)=="string" and v:match("^[%d%.]+x?$") then riftData.Multiplier=v; if not v:find("x",1,true) then riftData.Multiplier=v.."x" end; riftData.MultiplierValue=parseMultiplier(v); foundMultiplier=true; logMessage("debug", "  - Found Multi via StringValue: "..riftData.Multiplier); break end end end
                if not foundMultiplier then for _, pName in ipairs(PotentialMultiplierNames) do local att=island:GetAttribute(pName); if att then if type(att)=="number" then riftData.Multiplier=tostring(att).."x"; riftData.MultiplierValue=att; foundMultiplier=true; logMessage("debug", "  - Found Multi via Attribute: "..riftData.Multiplier); break elseif type(att)=="string" and att:match("^[%d%.]+x?$") then riftData.Multiplier=att; if not att:find("x",1,true) then riftData.Multiplier=att.."x" end; riftData.MultiplierValue=parseMultiplier(att); foundMultiplier=true; logMessage("debug", "  - Found Multi via String Attribute: "..riftData.Multiplier); break end end end end
                if not foundMultiplier then for _, d in ipairs(island:GetDescendants()) do if d:IsA("TextLabel") then local txt=d.Text or ""; local lt=string.lower(txt); if lt:match("x%d") or lt:match("%dx") then riftData.Multiplier=txt; riftData.MultiplierValue=parseMultiplier(txt); foundMultiplier=true; logMessage("debug", "  - Found potential Multi via GUI Text: "..riftData.Multiplier); break end end end end

                -- Apply Multiplier Filter (Handles "Or Above")
                if not foundMultiplier then
                    logMessage("debug", "  - Could not find Multiplier.")
                    if SearchMultiplierAny then logMessage("debug", "  - Filter: Processing anyway (Any)."); passedMultiplierFilter = true
                    else logMessage("debug", "  - Filter: Skipping (Specific Multi required & Multi unknown).") end
                else
                    if SearchMultiplierAny then
                        passedMultiplierFilter = true; logMessage("debug", "  - Filter: Multi "..riftData.Multiplier.." found (Any Multi OK)")
                    else -- Specific filter active
                        local multiplierNum = riftData.MultiplierValue
                        if not multiplierNum then logMessage("debug", "  - Skipping: Multi value unknown for specific filtering.")
                        else
                            local targetMulti = 0
                            local specificSelected = false
                            if SearchMultiplierOrAbove then
                                -- Find the lowest selected specific multiplier for "Or Above" check
                                if SearchMultiplier5x then targetMulti = 5; specificSelected = true end
                                if SearchMultiplier10x and (not specificSelected or 10 < targetMulti) then targetMulti = 10; specificSelected = true end
                                if SearchMultiplier25x and (not specificSelected or 25 < targetMulti) then targetMulti = 25; specificSelected = true end

                                if specificSelected and multiplierNum >= targetMulti then
                                    passedMultiplierFilter = true; logMessage("debug", string.format("  - Filter: Multi %s >= %sx (Or Above). MATCHES", riftData.Multiplier, targetMulti))
                                elseif not specificSelected then
                                     logMessage("debug", "  - Filter: 'Or Above' ON but no specific multi selected. Skipping.")
                                else
                                     logMessage("debug", string.format("  - Filter: Multi %s < %sx (Or Above). NO MATCH", riftData.Multiplier, targetMulti))
                                end
                            else -- Exact match required
                                local matchesExact = false
                                if SearchMultiplier5x and multiplierNum == 5 then matchesExact = true end
                                if SearchMultiplier10x and multiplierNum == 10 then matchesExact = true end
                                if SearchMultiplier25x and multiplierNum == 25 then matchesExact = true end
                                if matchesExact then passedMultiplierFilter = true; logMessage("debug", "  - Filter: Multi "..riftData.Multiplier.." MATCHES exact")
                                else logMessage("debug", "  - Filter: Multi "..riftData.Multiplier.." NO exact match") end
                            end
                        end
                    end
                end
            end -- End Multiplier Logic

            -- Find Details & Apply Time Filter (Only if Multiplier Filter Passed)
            if passedMultiplierFilter then
                logMessage("debug", "  - Passed Multi Filter. Finding details...")
                -- Find Position/Height
                local sP,pP=pcall(function() return island:GetPivot().Position end); if sP and pP then riftData.Position=pP; riftData.Height=math.floor(pP.Y); foundHeight=true; logMessage("debug", "  - Height via GetPivot: "..riftData.Height) else logMessage("debug", "  - GetPivot failed."); local sPos,rPos=pcall(function() if island:IsA("Model") and island.PrimaryPart then return island.PrimaryPart.Position elseif island:IsA("BasePart") then return island.Position else local _,cf=island:GetBoundingBox(); return cf.Position end end); if sPos and rPos then riftData.Position=rPos; riftData.Height=math.floor(rPos.Y); foundHeight=true; logMessage("debug", "  - Height via Pos/BBox: "..riftData.Height) else logMessage("debug", "  - Pos/BBox failed."); local hP=nil; for _,pN in ipairs(PotentialHeightParts) do hP=island:FindFirstChild(pN,true); if hP and hP:IsA("BasePart") then break end end; if hP and hP:IsA("BasePart") then riftData.Position=hP.Position; riftData.Height=math.floor(hP.Position.Y); foundHeight=true; logMessage("debug", "  - Height via Part: "..riftData.Height) else logMessage("debug", "  - Parts failed."); for _,pN in ipairs(PotentialHeightNames) do local hV=island:FindFirstChild(pN,true); if hV and (hV:IsA("NumberValue") or hV:IsA("IntValue")) then riftData.Height=math.floor(hV.Value); foundHeight=true; logMessage("debug", "  - Height via Value: "..riftData.Height); break end end; if not foundHeight then for _,pN in ipairs(PotentialHeightNames) do local hA=island:GetAttribute(pN); if hA and type(hA)=="number" then riftData.Height=math.floor(hA); foundHeight=true; logMessage("debug", "  - Height via Attr: "..riftData.Height); break end end end end end end; if not foundHeight then logMessage("debug", "  - Height unknown.") end

                -- Find Time Left (Prioritize TextLabel, fallback to Value/Attribute)
                logMessage("debug", "  - Searching for Time (TextLabel first)...")
                for _, d in ipairs(island:GetDescendants()) do
                    if d:IsA("TextLabel") then
                        local txt = d.Text or ""
                        local lt = string.lower(txt)
                        -- Look for MM:SS or sec/minutes patterns
                        if lt:match("%d+:%d+") or lt:match("%d+ ?sec") or lt:match("%d+ ?minutes?") then
                            riftData.TimeLeft = txt
                            riftData.TimeSeconds = parseTime(txt) -- Use our revised parser
                            if riftData.TimeSeconds then -- Check if parsing was successful
                                foundTime = true
                                logMessage("debug", "  - Time via GUI Text: " .. riftData.TimeLeft .. " -> Parsed: " .. tostring(riftData.TimeSeconds) .. "s")
                                break -- Found time via TextLabel, stop searching descendants for time
                            else
                                logMessage("debug", "  - Found potential time text '"..riftData.TimeLeft.."', but failed to parse.")
                                riftData.TimeLeft = "Parse Failed" -- Indicate parse failure
                            end
                        end
                    end
                end
                -- Fallback to Value/Attribute if not found via TextLabel
                if not foundTime then
                    logMessage("debug", "  - Time not found via TextLabel, checking Values/Attributes...")
                    for _, pN in ipairs(PotentialTimeNames) do local tV=island:FindFirstChild(pN,true); if tV and (tV:IsA("NumberValue") or tV:IsA("IntValue")) then riftData.TimeLeft=math.floor(tV.Value); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; logMessage("debug", "  - Time via Value: "..riftData.TimeLeft.."s"); break end end
                    if not foundTime then for _, pN in ipairs(PotentialTimeNames) do local tA=island:GetAttribute(pN); if tA and type(tA)=="number" then riftData.TimeLeft=math.floor(tA); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; logMessage("debug", "  - Time via Attr: "..riftData.TimeLeft.."s"); break end end end
                end
                if not foundTime then logMessage("debug", "  - Time unknown.") end

                -- Apply Time Filter
                if foundTime and riftData.TimeSeconds then
                    if riftData.TimeSeconds < MINIMUM_RIFT_TIME_SECONDS then
                        logMessage("debug", string.format("  - Filter: Skipping, Time %s (%s s) < %d s.", tostring(riftData.TimeLeft), riftData.TimeSeconds, MINIMUM_RIFT_TIME_SECONDS))
                        passedTimeFilter = false
                    else
                        logMessage("debug", string.format("  - Filter: Time %s (%s s) OK.", tostring(riftData.TimeLeft), riftData.TimeSeconds))
                        passedTimeFilter = true
                    end
                else
                    logMessage("debug", "  - Time unknown. Assuming passes time filter.")
                    passedTimeFilter = true -- Pass if time couldn't be determined
                end
            else logMessage("debug", "  - Skipping details (Multi Filter fail).") end

            -- Check if ALL filters passed for this rift
            if passedMultiplierFilter and passedTimeFilter then
                logMessage("info", string.format(">>> MATCH VALID: %s | Time: %s (%s s) | H: %s | Multi: %s <<<", riftData.DisplayName, tostring(riftData.TimeLeft), tostring(riftData.TimeSeconds or "??"), tostring(riftData.Height), tostring(riftData.Multiplier)))
                table.insert(foundRiftsList, riftData) -- Add to the list
            else
                logMessage("debug", "  - Invalid/Filtered. Continuing scan...")
            end
        -- else -- Uncomment for verbose logging of skipped types
        --  logMessage("debug", "Skipping rift type: " .. islandName .. " (Disabled in settings)")
        end
    end

    logMessage("info", "Search complete. Found " .. #foundRiftsList .. " valid rift(s).");
    return foundRiftsList -- Return the list (might be empty)
end

-- Get Player Count
local function getServerPlayerCount() return #Players:GetPlayers() end

-- Main Search and Hop Logic (Auto Run)
function startSearchAndHopLogic()
    local currentPlayers = getServerPlayerCount(); local maxPlayers = Players.MaxPlayers;
    logMessage("info", string.format("Start cycle. Players: %d/%d", currentPlayers, maxPlayers))
    if currentPlayers >= maxPlayers then
        logMessage("info", "Server full. Hopping...")
        attemptHop("Server full")
        return -- Stop execution here as hop was attempted
    end

    local foundRiftsList = findTargetRifts() -- Get the list of found rifts

    if #foundRiftsList > 0 then
        logMessage("info", "MATCH(ES) FOUND! Notifying for " .. #foundRiftsList .. " rift(s)...")
        -- Notify for each found rift
        for _, riftData in ipairs(foundRiftsList) do
            sendRiftNotification(riftData)
            task.wait(0.5) -- Small delay between notifications if multiple found
        end

        logMessage("info", "Notifications sent. Hopping server...")
        attemptHop("Found " .. #foundRiftsList .. " matching rift(s)") -- Hop after notifying for all

    else
        logMessage("info", "No valid rift found matching filters. Hopping...")
        attemptHop("Rift not found/filtered") -- Hop if nothing was found
    end
    -- Script execution ends after attemptHop is called
end


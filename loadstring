                    local sP_h,pP_h=pcall(function() return island:GetPivot().Position end); if sP_h and pP_h then riftData.Position=pP_h; riftData.Height=math.floor(pP_h.Y); foundHeight=true; print("  - Height via GetPivot:",riftData.Height) else print("  - GetPivot failed."); local sPos_h,rPos_h=pcall(function() if island:IsA("Model") and island.PrimaryPart then return island.PrimaryPart.Position elseif island:IsA("BasePart") then return island.Position else local _,cf=island:GetBoundingBox(); return cf.Position end end); if sPos_h and rPos_h then riftData.Position=rPos_h; riftData.Height=math.floor(rPos_h.Y); foundHeight=true; print("  - Height via Pos/BBox:",riftData.Height) else print("  - Pos/BBox failed."); local hP=nil; for _,pN in ipairs(PotentialHeightParts) do hP=island:FindFirstChild(pN,true); if hP and hP:IsA("BasePart") then break end end; if hP and hP:IsA("BasePart") then riftData.Position=hP.Position; riftData.Height=math.floor(hP.Position.Y); foundHeight=true; print("  - Height via Part:",riftData.Height) else print("  - Parts failed."); for _,pN in ipairs(PotentialHeightNames) do local hV=island:FindFirstChild(pN,true); if hV and (hV:IsA("NumberValue") or hV:IsA("IntValue")) then riftData.Height=math.floor(hV.Value); foundHeight=true; print("  - Height via Value:",riftData.Height); break end end; if not foundHeight then for _,pN in ipairs(PotentialHeightNames) do local hA=island:GetAttribute(pN); if hA and type(hA)=="number" then riftData.Height=math.floor(hA); foundHeight=true; print("  - Height via Attr:",riftData.Height); break end end end end end end; if not foundHeight then print("  - Height unknown.") end
                    print("  - Searching for Time (Original Method)..."); foundTime = false; for _,pN in ipairs(PotentialTimeNames) do local tV=island:FindFirstChild(pN,true); if tV and (tV:IsA("NumberValue") or tV:IsA("IntValue")) then riftData.TimeLeft=math.floor(tV.Value); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; print("  - Time via Value:", riftData.TimeLeft); break end end; if not foundTime then for _,pN in ipairs(PotentialTimeNames) do local tA=island:GetAttribute(pN); if tA and type(tA)=="number" then riftData.TimeLeft=math.floor(tA); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; print("  - Time via Attr:",riftData.TimeLeft); break end end end; if not foundTime then for _,d in ipairs(island:GetDescendants()) do if d:IsA("TextLabel") then local txt=d.Text or ""; local lt=string.lower(txt); if lt:match("%d+:%d+") or lt:match("%d+ ?sec") or lt:match("%d+ ?minutes?") then riftData.TimeLeft=txt; riftData.TimeSeconds=parseTime(txt); foundTime=true; print("  - Time via GUI Text:",riftData.TimeLeft,"-> Parsed Secs:",tostring(riftData.TimeSeconds or "nil")); break end end end end; if not foundTime then print("  - Time unknown.") end
                    if foundTime and riftData.TimeSeconds then if riftData.TimeSeconds<MINIMUM_RIFT_TIME_SECONDS then print(string.format("  - Filter: Skipping, Time %s (%s s)<%d s.",tostring(riftData.TimeLeft),riftData.TimeSeconds,MINIMUM_RIFT_TIME_SECONDS)); passedTimeFilter=false else print(string.format("  - Filter: Time %s (%s s) OK.",tostring(riftData.TimeLeft),riftData.TimeSeconds)); passedTimeFilter=true end else print("  - Time unknown. Assuming passes filter."); passedTimeFilter=true end
                else print("  - Skipping details (Multi Filter fail).") end


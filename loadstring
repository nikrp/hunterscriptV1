--// Server Blacklist Setup & Persistence Functions
_G.visitedServers = _G.visitedServers or {}

local function countBlacklist()
    local count = 0
    if _G.visitedServers then
        for _ in pairs(_G.visitedServers) do count = count + 1 end
    end
    return count
end

local function logMessage(level, message)
    local prefix = "[" .. os.date("%H:%M:%S") .. "] [" .. level:upper() .. "] "
    local fullMessage = prefix .. message

    if SendLogsToWebhook and LogWebhookURL and string.len(LogWebhookURL) > 20 then
        -- Try sending to webhook
        local payloadData = { content = "```\n" .. fullMessage .. "\n```", username = "Rift Finder Logs" }
        local encodeSuccess, encodedPayload = pcall(HttpService.JSONEncode, HttpService, payloadData)
        if not encodeSuccess then
            print(prefix .. "WARN: JSONEncode failed for log webhook: " .. tostring(encodedPayload))
            print(fullMessage) -- Fallback to console print
            return
        end

        local success, response = false, "No request attempt"
        if request and type(request) == "function" then
            success, response = pcall(request, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
            if not success then
                 print(prefix .. "WARN: 'request' failed for log webhook: " .. tostring(response))
                 print(fullMessage) -- Fallback to console print
            end
        else
            -- Fallback to HttpService if 'request' is not available
             success, response = pcall(HttpService.RequestAsync, HttpService, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
             if not success then
                 print(prefix .. "WARN: HttpService log webhook failed (Likely blocked): " .. tostring(response))
                 print(fullMessage) -- Fallback to console print
             end
        end
    else
        -- Default: Print to console
        if level == "warn" or level == "error" then
            warn(fullMessage)
        else
            print(fullMessage)
        end
    end
end


local function loadBlacklist()
    -- Use logMessage for output
    if isfile and readfile and isfile(BLACKLIST_FILENAME) then
        logMessage("info", "Attempting to load blacklist from: " .. BLACKLIST_FILENAME)
        local success, fileContent = pcall(readfile, BLACKLIST_FILENAME)
        if success and fileContent and type(fileContent) == "string" and #fileContent > 2 then
            local decodeSuccess, loadedTable = pcall(HttpService.JSONDecode, HttpService, fileContent)
            if decodeSuccess and type(loadedTable) == "table" then
                _G.visitedServers = loadedTable
                logMessage("info", "Successfully loaded blacklist. Size: " .. countBlacklist())
            else
                logMessage("warn", "Failed to decode blacklist JSON or file was invalid: " .. (decodeSuccess and tostring(loadedTable) or "Decode Error"))
                _G.visitedServers = {}
            end
        else
            logMessage("warn", "Failed to read blacklist file or file empty/invalid: " .. (success and "Read OK but empty/invalid" or "Read Error"))
             _G.visitedServers = {}
        end
    else
        if not isfile or not readfile then logMessage("warn", "Executor does not support 'isfile' or 'readfile'. Blacklist persistence disabled.") end
        logMessage("info", "Blacklist file not found or file functions unsupported. Initializing empty blacklist.")
        _G.visitedServers = {}
    end
    if CurrentJobId and not _G.visitedServers[CurrentJobId] then
        logMessage("info", "Adding current server to loaded/new blacklist: " .. CurrentJobId)
        _G.visitedServers[CurrentJobId] = true
    end
end

local function saveBlacklist()
    if writefile then
        logMessage("info", "Attempting to save blacklist...")
        local currentSize = countBlacklist()
        local encodeSuccess, jsonContent = pcall(HttpService.JSONEncode, HttpService, _G.visitedServers)
        if encodeSuccess and jsonContent then
            local writeSuccess, writeResponse = pcall(writefile, BLACKLIST_FILENAME, jsonContent)
            if writeSuccess then
                logMessage("info", "Successfully saved blacklist. Size: " .. currentSize)
            else
                logMessage("warn", "Failed to write blacklist file: " .. tostring(writeResponse))
            end
        else
            logMessage("warn", "Failed to JSONEncode blacklist for saving: " .. (encodeSuccess and "Encode OK but nil content?" or tostring(jsonContent)))
        end
    else
        -- Don't warn every time if unsupported, loadBlacklist already warned.
    end
end


-- Get Server List (Executor Dependent, Enhanced Debugging, Increased Delay) - REVERTED LOGIC
local function getServers()
    print("Attempting to fetch server list via global 'request'...")
    if not request or type(request) ~= "function" then warn("Executor does not provide 'request' function. Cannot fetch server list."); return nil end
    local servers = {}; local cursor = ""; local attempts = 0; local maxAttempts = 5 -- Limit pages fetched
    local fetchUrlBase = "https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    while attempts < maxAttempts do
        attempts = attempts + 1
        local url = fetchUrlBase .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        print(string.format("Fetching server page %d...", attempts))
        local success, response = pcall(request, {Url = url, Method = "GET"})
        local processPage = true -- Flag to control processing

        if not success or not response or type(response) ~= "table" or not response.Body then
            warn(string.format("  - Failed to fetch server list via 'request' on attempt %d. Success: %s", attempts, tostring(success)))
            processPage = false
        elseif type(response.Body) ~= "string" then
             warn(string.format("  - Invalid response body type on page %d: %s. Expected string.", attempts, type(response.Body)))
             processPage = false
        end

        if processPage then
            -- Try to decode only if the fetch seemed okay and body is a string
            local decodeSuccess, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
            if decodeSuccess and type(data) == "table" and data.data then
                local count = 0; for _, v in pairs(data.data) do if type(v) == "table" and v.id and v.playing and v.maxPlayers then table.insert(servers, {id = v.id, playing = v.playing, maxPlayers = v.maxPlayers}); count = count + 1 end end; print(string.format("  - Decoded page %d, added %d servers.", attempts, count))
                if data.nextPageCursor then cursor = data.nextPageCursor; print("  - Found nextPageCursor.") else print("  - Reached end of server list."); break end -- Exit loop if no next page
            else
                warn(string.format("  - Failed to decode server list JSON or invalid format on page %d. Decode Success: %s", attempts, tostring(decodeSuccess)))
                local bodySample = string.sub(response.Body, 1, 500) -- Already checked body is string
                warn("  - Raw response body on decode error (first 500 chars): \n" .. bodySample)
                -- Check if the error is rate limiting
                if string.find(bodySample, "Too many requests", 1, true) then
                    warn("  - RATE LIMIT DETECTED. Waiting longer before next attempt...")
                    task.wait(SERVER_FETCH_DELAY * 2) -- Wait even longer if rate limited
                end
            end
        else
             -- Fetch failed or body type wrong, wait before next attempt or break
             task.wait(1)
             if attempts >= maxAttempts then
                 warn("  - Max fetch attempts reached after error.")
                 break -- Stop trying if max attempts hit after a failure
             end
        end

        -- Wait between page fetches to avoid rate limits
        print(string.format("  - Waiting %d seconds before next page fetch...", SERVER_FETCH_DELAY))
        task.wait(SERVER_FETCH_DELAY)
    end
    print("Finished fetching servers. Total found:", #servers); return servers
end


-- Attempt Teleport (Uses Blacklist, Saves Blacklist Before Hop, Clears Blacklist at Limit) - REVERTED LOGIC
local function attemptHop(reason)
    -- Send hop notification to the dedicated webhook
    sendHopNotification(reason)
    task.wait(1) -- Keep a small delay after notification

    local serverList = getServers() -- Get the full list again
    local targetServerId = nil

    if serverList and #serverList > 0 then
        print("Filtering server list (Size:", #serverList, ")");
        local validServers = {}
        local currentBlacklistSize = countBlacklist() -- Use helper function
        local skippedBlacklisted = 0
        for _, serverInfo in ipairs(serverList) do
            local isVisited = _G.visitedServers[serverInfo.id]
            if isVisited then skippedBlacklisted = skippedBlacklisted + 1 end
            if serverInfo.id ~= CurrentJobId and serverInfo.playing < serverInfo.maxPlayers and not isVisited then
                table.insert(validServers, serverInfo.id)
            end
        end
        print(string.format("Filtering complete. Valid Servers Found: %d | Skipped (Blacklisted): %d | Current Blacklist Size: %d", #validServers, skippedBlacklisted, currentBlacklistSize))
        if #validServers > 0 then
            targetServerId = validServers[math.random(1, #validServers)] -- Select random valid server
            print("Selected target server JobId:", targetServerId)
            _G.visitedServers[targetServerId] = true
            local newSize = countBlacklist() -- Recount after adding
            print("Added target to blacklist. New size:", newSize)

            -- *** Check and Clear Blacklist if Limit Reached ***
            if newSize >= MAX_BLACKLIST_SIZE then
                warn("Blacklist limit (" .. MAX_BLACKLIST_SIZE .. ") reached! Clearing blacklist.")
                _G.visitedServers = {} -- Reset the table
                if CurrentJobId then -- Re-add current server after clearing
                    print("Re-adding current server to cleared blacklist:", CurrentJobId)
                    _G.visitedServers[CurrentJobId] = true
                end
                print("Blacklist cleared. New size:", countBlacklist())
            end
        else
            warn("No valid *new* non-blacklisted servers found. Falling back to generic teleport.")
        end
    else
        warn("Server list empty or failed to fetch. Falling back to generic teleport.")
    end

    -- *** SAVE BLACKLIST BEFORE TELEPORTING ***
    saveBlacklist()
    task.wait(0.5) -- Small delay after saving

    local success, err
    if targetServerId then
        print("Attempting TeleportToPlaceInstance:", targetServerId)
        success, err = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, PlaceId, targetServerId, Player)
        if not success then
             -- Check for specific unauthorized error
             if err and type(err) == "string" and string.find(err, "Unauthorized", 1, true) then
                 warn("TeleportToPlaceInstance failed: Unauthorized (Cannot join specific private instance). Falling back to generic join.")
             else
                 warn("TeleportToPlaceInstance failed:", err)
             end
             -- Fallback to generic teleport regardless of specific error
             print("Hop manually or wait for generic teleport fallback...")
             task.wait(1) -- Short wait before generic attempt
             saveBlacklist() -- Save again just in case
             task.wait(0.5)
             print("Attempting generic Teleport...")
             local genSuccess, genErr = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
             if not genSuccess then
                 warn("Generic Teleport also failed:", genErr); print("Hop manually & re-execute.") BotStarted = false; -- Stop bot if totally failed
             else
                 print("Generic Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
             end
        else
             print("Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
        end
    else
        -- No specific valid server found, fall back to generic teleport
        -- Blacklist already saved above
        print("Attempting generic Teleport...")
        success, err = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
        if not success then
            warn("Generic Teleport failed:", err); print("Hop manually & re-execute."); BotStarted = false; -- Stop bot if totally failed
        else
            print("Generic Teleport initiated. Script stopping. REMEMBER TO RE-EXECUTE MANUALLY!")
        end
    end
end


-- Parse Multiplier Text
local function parseMultiplier(multiplierText) if not multiplierText or type(multiplierText) ~= "string" then return nil end; local numStr = string.match(multiplierText, "[%d%.]+"); if numStr then return tonumber(numStr) end; return nil end

-- Parse Time Text
local function parseTime(timeText) if not timeText or type(timeText) ~= "string" then return nil end; local totalSeconds=0; local minutes=string.match(timeText,"(%d+) ?minutes?"); if minutes then totalSeconds=tonumber(minutes)*60; local seconds=string.match(timeText,"(%d+) ?sec"); if seconds then totalSeconds=totalSeconds+tonumber(seconds) end; return totalSeconds end; local secondsOnly=string.match(timeText,"(%d+) ?sec"); if secondsOnly then return tonumber(secondsOnly) end; local parts={}; for part in string.gmatch(timeText,"%d+") do table.insert(parts,tonumber(part)) end; if #parts==2 then totalSeconds=parts[1]*60+parts[2]; return totalSeconds elseif #parts==3 then totalSeconds=parts[1]*3600+parts[2]*60+parts[3]; return totalSeconds end; local numOnly=tonumber(timeText); if numOnly then return numOnly end; return nil end

-- Find Target Rift (Returns FIRST valid match or nil) - USING ORIGINAL FINDING LOGIC

--// Logging Function (Sends to Webhook OR Console)
local function logMessage(level, ...)
    local args = {...}
    local messageParts = {}
    for i = 1, #args do
        table.insert(messageParts, tostring(args[i]))
    end
    local message = table.concat(messageParts, "\t") -- Concatenate arguments with tabs
    local timestamp = os.date("!%H:%M:%SZ") -- Use UTC time for consistency
    local logPrefix = string.format("[%s] [%s] ", timestamp, level)
    local fullMessage = logPrefix .. message

    if SendLogsToWebhook then
        if not LogWebhookURL or string.len(LogWebhookURL) < 20 then
            old_warn("LogWebhookURL is invalid, cannot send log via webhook:", fullMessage)
            return
        end
        local payload = {
            content = "```\n" .. fullMessage .. "\n```", -- Use code block for better formatting
            username = "Rift Script Log"
        }
        local encodeSuccess, encodedPayload = pcall(HttpService.JSONEncode, HttpService, payload)
        if not encodeSuccess then return end -- Cannot log encode error itself easily

        -- Use request if available, otherwise fallback (silently fail if both fail)
        if request and type(request) == "function" then
            pcall(request, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        elseif HttpService.RequestAsync then
            pcall(HttpService.RequestAsync, HttpService, { Url = LogWebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = encodedPayload })
        end
    else
        -- Send to console using original functions
        if level == "WARN" then
            old_warn(fullMessage)
        else
            old_print(fullMessage)
        end
    end
end


-- Get Server List
local function getServers()
    sendLogMessage("Attempting to fetch server list...")
    local request_func = request -- Capture global request
    if not request_func or type(request_func) ~= "function" then sendLogMessage("Executor does not provide 'request' function. Cannot fetch server list.", "ERROR"); return nil end

    local servers = {}; local cursor = ""; local attempts = 0; local maxAttempts = 5
    local fetchUrlBase = "https://games.roblox.com/v1/games/".. (PlaceId or 0) .."/servers/Public?sortOrder=Asc&limit=100"
    if not PlaceId then sendLogMessage("PlaceId is nil, cannot fetch servers.", "ERROR"); return nil end

    while attempts < maxAttempts do
        attempts = attempts + 1
        local url = fetchUrlBase .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
        sendLogMessage(string.format("Fetching server page %d...", attempts))
        local success, response = pcall(request_func, {Url = url, Method = "GET"})
        local responseBody = nil

        if success and response and type(response) == "table" and response.Body and type(response.Body) == "string" then
             responseBody = response.Body
        else
             sendLogMessage(string.format("  - Failed/Invalid response from 'request' on attempt %d. Success: %s, ResponseType: %s", attempts, tostring(success), type(response)), "WARN")
             task.wait(1); if attempts >= maxAttempts then break end; goto continue_loop -- Skip processing this page
        end

        -- Process valid responseBody
        local decodeSuccess, data = pcall(HttpService.JSONDecode, HttpService, responseBody)
        if decodeSuccess and type(data) == "table" and data.data then
            local count = 0; for _, v in pairs(data.data) do if type(v) == "table" and v.id and v.playing and v.maxPlayers then table.insert(servers, {id = v.id, playing = v.playing, maxPlayers = v.maxPlayers}); count = count + 1 end end; sendDetailedLog(string.format("  - Decoded page %d, added %d servers.", attempts, count))
            if data.nextPageCursor then cursor = data.nextPageCursor; sendDetailedLog("  - Found nextPageCursor.") else sendLogMessage("  - Reached end of server list."); break end
        else
            sendLogMessage(string.format("  - Failed to decode server list JSON or invalid format on page %d. Decode Success: %s", attempts, tostring(decodeSuccess)), "WARN")
            local bodySample = string.sub(responseBody, 1, 500)
            sendLogMessage("  - Raw response body on decode error (first 500 chars): \n" .. bodySample, "WARN")
            if string.find(bodySample, "Too many requests", 1, true) then
                sendLogMessage("  - RATE LIMIT DETECTED. Waiting longer...", "WARN")
                task.wait(SERVER_FETCH_DELAY * 2)
            end
        end

        ::continue_loop::
        sendDetailedLog(string.format("  - Waiting %d seconds before next page fetch...", SERVER_FETCH_DELAY))
        task.wait(SERVER_FETCH_DELAY)
    end
    sendLogMessage("Finished fetching servers. Total found: " .. #servers); return servers
end

-- Attempt Teleport
local function attemptHop(reason)
    sendHopNotification(reason)
    task.wait(1)

    local serverList = getServers()
    local targetServerId = nil

    if serverList and #serverList > 0 then
        sendLogMessage("Filtering server list (Size: " .. #serverList .. ")")
        local validServers = {}
        local currentBlacklistSize = countBlacklist()
        local skippedBlacklisted = 0
        for _, serverInfo in ipairs(serverList) do
            local isVisited = _G.visitedServers[serverInfo.id]
            if isVisited then skippedBlacklisted = skippedBlacklisted + 1 end
            if serverInfo.id ~= CurrentJobId and serverInfo.playing < serverInfo.maxPlayers and not isVisited then
                table.insert(validServers, serverInfo.id)
            end
        end
        sendLogMessage(string.format("Filtering complete. Valid Servers Found: %d | Skipped (Blacklisted): %d | Current Blacklist Size: %d", #validServers, skippedBlacklisted, currentBlacklistSize))
        if #validServers > 0 then
            targetServerId = validServers[math.random(1, #validServers)]
            sendLogMessage("Selected target server JobId: " .. targetServerId)
            _G.visitedServers[targetServerId] = true
            local newSize = countBlacklist()
            sendLogMessage("Added target to blacklist. New size: " .. newSize)
            if newSize >= MAX_BLACKLIST_SIZE then
                sendLogMessage("Blacklist limit (" .. MAX_BLACKLIST_SIZE .. ") reached! Clearing blacklist.", "WARN")
                _G.visitedServers = {}; if CurrentJobId then _G.visitedServers[CurrentJobId] = true end
                sendLogMessage("Blacklist cleared. New size: " .. countBlacklist())
            end
        else sendLogMessage("No valid *new* non-blacklisted servers found. Falling back.", "WARN") end
    else sendLogMessage("Server list empty or failed to fetch. Falling back.", "WARN") end

    saveBlacklist(); task.wait(0.5)

    local tpSuccess, tpErr
    if targetServerId then
        sendLogMessage("Attempting TeleportToPlaceInstance: " .. targetServerId)
        tpSuccess, tpErr = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, PlaceId, targetServerId, Player)
        if not tpSuccess then
             if tpErr and type(tpErr) == "string" and string.find(tpErr, "Unauthorized", 1, true) then sendLogMessage("TeleportToPlaceInstance failed: Unauthorized. Falling back.", "WARN")
             else sendLogMessage("TeleportToPlaceInstance failed: " .. tostring(tpErr), "ERROR") end
             sendLogMessage("Falling back to generic Teleport...")
             task.wait(1); saveBlacklist(); task.wait(0.5)
             local genSuccess, genErr = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
             if not genSuccess then sendLogMessage("Generic Teleport also failed: " .. tostring(genErr), "ERROR"); sendLogMessage("Hop manually & re-execute.")
             else sendLogMessage("Generic Teleport initiated. Script stopping. RE-EXECUTE MANUALLY!") end
        else sendLogMessage("Teleport initiated. Script stopping. RE-EXECUTE MANUALLY!") end
    else
        sendLogMessage("Attempting generic Teleport...")
        tpSuccess, tpErr = pcall(TeleportService.Teleport, TeleportService, PlaceId, Player)
        if not tpSuccess then sendLogMessage("Generic Teleport failed: " .. tostring(tpErr), "ERROR"); sendLogMessage("Hop manually & re-execute.")
        else sendLogMessage("Generic Teleport initiated. Script stopping. RE-EXECUTE MANUALLY!") end
    end
end

-- Parse Multiplier Text
local function parseMultiplier(multiplierText) if not multiplierText or type(multiplierText) ~= "string" then return nil end; local numStr = string.match(multiplierText, "[%d%.]+"); if numStr then return tonumber(numStr) end; return nil end

-- Parse Time Text
local function parseTime(timeText) if not timeText or type(timeText) ~= "string" then return nil end; local totalSeconds=0; local minutes=string.match(timeText,"(%d+) ?minutes?"); if minutes then totalSeconds=tonumber(minutes)*60; local seconds=string.match(timeText,"(%d+) ?sec"); if seconds then totalSeconds=totalSeconds+tonumber(seconds) end; return totalSeconds end; local secondsOnly=string.match(timeText,"(%d+) ?sec"); if secondsOnly then return tonumber(secondsOnly) end; local parts={}; for part in string.gmatch(timeText,"%d+") do table.insert(parts,tonumber(part)) end; if #parts==2 then totalSeconds=parts[1]*60+parts[2]; return totalSeconds elseif #parts==3 then totalSeconds=parts[1]*3600+parts[2]*60+parts[3]; return totalSeconds end; local numOnly=tonumber(timeText); if numOnly then return numOnly end; return nil end

-- Find Target Rift (Uses Config Variables, Targets Rare Eggs)
local function findTargetRift()
    local searchCriteria = "Searching for: "
    if SEARCH_TARGET_EGGS then
        local eggNames = ""
        for eggName, _ in pairs(TargetEggLookup) do eggNames = eggNames .. eggName .. ", " end
        searchCriteria = searchCriteria .. "Target Eggs (" .. string.sub(eggNames, 1, -3) .. ") | " -- Remove trailing comma and space
    else
        searchCriteria = searchCriteria .. "Any Rift Type | "
    end
    if SEARCH_SPECIFIC_MULTIPLIER then searchCriteria = searchCriteria .. (SEARCH_MULTIPLIER_OR_ABOVE and ">=" or "==") .. TARGET_MULTIPLIER .. "x Multi | "
    else searchCriteria = searchCriteria .. "Any Multiplier | " end
    searchCriteria = searchCriteria .. "Min Time: " .. MINIMUM_TIME_REQUIRED .. "s"
    sendLogMessage(searchCriteria)

    sendLogMessage("Waiting for folder '"..RENDERED_FOLDER_NAME.."'...")
    local renderedFolder = workspace:WaitForChild(RENDERED_FOLDER_NAME, WAIT_FOR_FOLDERS_TIMEOUT); if not renderedFolder then sendLogMessage("'"..RENDERED_FOLDER_NAME.."' folder not found.", "ERROR"); return nil end
    sendLogMessage("Waiting for folder '"..TARGET_RIFTS_FOLDER_NAME.."'...")
    local islandsFolder = renderedFolder:WaitForChild(TARGET_RIFTS_FOLDER_NAME, WAIT_FOR_FOLDERS_TIMEOUT); if not islandsFolder then sendLogMessage("'"..TARGET_RIFTS_FOLDER_NAME.."' folder not found.", "ERROR"); return nil end
    sendLogMessage("Scanning folder: " .. islandsFolder:GetFullName())

    for _, island in ipairs(islandsFolder:GetChildren()) do
        if not (island:IsA("Model") or island:IsA("Folder")) then continue end
        local islandName = island.Name
        local islandNameLower = string.lower(islandName)

        -- Filter 1: Check if the Rift Type matches configuration
        local typeMatches = false
        if not SEARCH_TARGET_EGGS then typeMatches = true -- Searching for any type
        elseif TargetEggLookup[islandNameLower] then typeMatches = true -- Specific rare egg matches
        end

        if typeMatches then
            sendDetailedLog("Potential match found (Type): " .. islandName)
            local displayName = RiftDisplayNameMapping[islandNameLower] or islandName
            local riftData = { Name = islandName, NameLower = islandNameLower, DisplayName = displayName, TimeLeft = "Unknown", TimeSeconds = nil, Height = "Unknown", Position = "Unknown", Multiplier = "Unknown", MultiplierValue = nil, Instance = island }
            local foundMultiplier, foundTime, foundHeight = false, false, false
            local passedMultiplierFilter = false
            local passedTimeFilter = false

            -- Find Multiplier Value & Filter 2
            if NoMultiplierTypes[islandNameLower] then
                sendDetailedLog("  - Type has no multiplier. Setting N/A.")
                riftData.Multiplier = "N/A"; riftData.MultiplierValue = nil; foundMultiplier = true
                passedMultiplierFilter = true
            else
                -- Find Multiplier (Original Logic)
                for _, pName in ipairs(PotentialMultiplierNames) do local obj=island:FindFirstChild(pName,true); if obj and obj:IsA("ValueBase") then local v=obj.Value; if type(v)=="number" then riftData.Multiplier=tostring(v).."x"; riftData.MultiplierValue=v; foundMultiplier=true; sendDetailedLog("   - Found Multi via Value: ".. riftData.Multiplier); break elseif type(v)=="string" and v:match("^[%d%.]+x?$") then riftData.Multiplier=v; if not v:find("x",1,true) then riftData.Multiplier=v.."x" end; riftData.MultiplierValue=parseMultiplier(v); foundMultiplier=true; sendDetailedLog("   - Found Multi via StringValue: " .. riftData.Multiplier); break end end end
                if not foundMultiplier then for _, pName in ipairs(PotentialMultiplierNames) do local att=island:GetAttribute(pName); if att then if type(att)=="number" then riftData.Multiplier=tostring(att).."x"; riftData.MultiplierValue=att; foundMultiplier=true; sendDetailedLog("   - Found Multi via Attribute: " .. riftData.Multiplier); break elseif type(att)=="string" and att:match("^[%d%.]+x?$") then riftData.Multiplier=att; if not att:find("x",1,true) then riftData.Multiplier=att.."x" end; riftData.MultiplierValue=parseMultiplier(att); foundMultiplier=true; sendDetailedLog("   - Found Multi via String Attribute: " .. riftData.Multiplier); break end end end end
                if not foundMultiplier then for _, d in ipairs(island:GetDescendants()) do if d:IsA("TextLabel") then local txt=d.Text or ""; local lt=string.lower(txt); if lt:match("x%d") or lt:match("%dx") then riftData.Multiplier=txt; riftData.MultiplierValue=parseMultiplier(txt); foundMultiplier=true; sendDetailedLog("   - Found potential Multi via GUI Text: " .. riftData.Multiplier); break end end end end

                -- Apply Multiplier Filter
                if not SEARCH_SPECIFIC_MULTIPLIER then passedMultiplierFilter = true; sendDetailedLog(foundMultiplier and ("  - Filter: Multi " .. riftData.Multiplier .. " found (Ignoring Filter)") or "  - Filter: Multi Unknown (Ignoring Filter)")
                elseif not foundMultiplier or not riftData.MultiplierValue then sendDetailedLog("  - Filter: Skipping (Multiplier Filter ON, but Multi unknown)")
                else
                     local multiNum = riftData.MultiplierValue
                     if SEARCH_MULTIPLIER_OR_ABOVE then
                        if multiNum >= TARGET_MULTIPLIER then passedMultiplierFilter = true; sendDetailedLog(string.format("  - Filter: Multi %s >= %sx. MATCHES", riftData.Multiplier, TARGET_MULTIPLIER))
                        else sendDetailedLog(string.format("  - Filter: Multi %s < %sx. NO MATCH", riftData.Multiplier, TARGET_MULTIPLIER)) end
                     else
                         if multiNum == TARGET_MULTIPLIER then passedMultiplierFilter = true; sendDetailedLog(string.format("  - Filter: Multi %s == %sx. MATCHES", riftData.Multiplier, TARGET_MULTIPLIER))
                         else sendDetailedLog(string.format("  - Filter: Multi %s != %sx. NO MATCH", riftData.Multiplier, TARGET_MULTIPLIER)) end
                     end
                end
            end

            -- Filter 3: Apply Time Filter (only if Multiplier passed)
            if passedMultiplierFilter then
                -- Find Time (Original Logic)
                sendDetailedLog("  - Searching for Time..."); for _,pN in ipairs(PotentialTimeNames) do local tV=island:FindFirstChild(pN,true); if tV and (tV:IsA("NumberValue") or tV:IsA("IntValue")) then riftData.TimeLeft=math.floor(tV.Value); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; sendDetailedLog("   - Time via Value: "..riftData.TimeLeft); break end end; if not foundTime then for _,pN in ipairs(PotentialTimeNames) do local tA=island:GetAttribute(pN); if tA and type(tA)=="number" then riftData.TimeLeft=math.floor(tA); riftData.TimeSeconds=riftData.TimeLeft; foundTime=true; sendDetailedLog("   - Time via Attr: "..riftData.TimeLeft); break end end end; if not foundTime then for _,d in ipairs(island:GetDescendants()) do if d:IsA("TextLabel") then local txt=d.Text or ""; local lt=string.lower(txt); if lt:match("%d+:%d+") or lt:match("%d+ ?sec") or lt:match("%d+ ?minutes?") then riftData.TimeLeft=txt; riftData.TimeSeconds=parseTime(txt); foundTime=true; sendDetailedLog("   - Time via GUI Text: "..riftData.TimeLeft.."-> Parsed: "..tostring(riftData.TimeSeconds)); break end end end end; if not foundTime then sendDetailedLog("   - Time unknown.") end

                -- Apply Time Filter
                if not foundTime or not riftData.TimeSeconds then sendDetailedLog("  - Filter: Skipping (Time Unknown).")
                elseif riftData.TimeSeconds >= MINIMUM_TIME_REQUIRED then passedTimeFilter = true; sendDetailedLog(string.format("  - Filter: Time %s (%s s) >= %d s. MATCHES", tostring(riftData.TimeLeft), riftData.TimeSeconds, MINIMUM_TIME_REQUIRED))
                else sendDetailedLog(string.format("  - Filter: Skipping, Time %s (%s s) < %d s.", tostring(riftData.TimeLeft), riftData.TimeSeconds, MINIMUM_TIME_REQUIRED)) end
            else sendDetailedLog("  - Skipping Time check (Multiplier Filter Failed)") end

            -- Final Check: If all filters passed, find remaining details and return
            if passedMultiplierFilter and passedTimeFilter then
                 sendDetailedLog("  - Passed All Filters. Finding Height/Pos...")
                 -- Find Position/Height (Original Logic)
                 local sP,pP=pcall(function() return island:GetPivot().Position end); if sP and pP then riftData.Position=pP; riftData.Height=math.floor(pP.Y); foundHeight=true; sendDetailedLog("   - Height via GetPivot:"..riftData.Height) else sendDetailedLog("   - GetPivot failed."); local sPos,rPos=pcall(function() if island:IsA("Model") and island.PrimaryPart then return island.PrimaryPart.Position elseif island:IsA("BasePart") then return island.Position else local _,cf=island:GetBoundingBox(); return cf.Position end end); if sPos and rPos then riftData.Position=rPos; riftData.Height=math.floor(rPos.Y); foundHeight=true; sendDetailedLog("   - Height via Pos/BBox:"..riftData.Height) else sendDetailedLog("   - Pos/BBox failed."); local hP=nil; for _,pN in ipairs(PotentialHeightParts) do hP=island:FindFirstChild(pN,true); if hP and hP:IsA("BasePart") then break end end; if hP and hP:IsA("BasePart") then riftData.Position=hP.Position; riftData.Height=math.floor(hP.Position.Y); foundHeight=true; sendDetailedLog("   - Height via Part:"..riftData.Height) else sendDetailedLog("   - Parts failed."); for _,pN in ipairs(PotentialHeightNames) do local hV=island:FindFirstChild(pN,true); if hV and (hV:IsA("NumberValue") or hV:IsA("IntValue")) then riftData.Height=math.floor(hV.Value); foundHeight=true; sendDetailedLog("   - Height via Value:"..riftData.Height); break end end; if not foundHeight then for _,pN in ipairs(PotentialHeightNames) do local hA=island:GetAttribute(pN); if hA and type(hA)=="number" then riftData.Height=math.floor(hA); foundHeight=true; sendDetailedLog("   - Height via Attr:"..riftData.Height); break end end end end end end; if not foundHeight then sendDetailedLog("   - Height unknown.") end

                sendLogMessage(string.format(">>> MATCH VALID: %s | Time: %s (%s s) | H: %s | Multi: %s <<<", riftData.DisplayName, tostring(riftData.TimeLeft), tostring(riftData.TimeSeconds or "??"), tostring(riftData.Height), tostring(riftData.Multiplier)))
                return riftData -- Return the valid rift data
            else sendDetailedLog("  - Invalid/Filtered. Continuing search...") end
        end -- End typeMatches check
    end -- End loop through islands

    sendLogMessage("Search complete. No valid matches found in this server based on filters.");
    return nil -- No match found
end

-- Get Player Count
local function getServerPlayerCount() return #Players:GetPlayers() end

-- Main Search and Hop Logic
function runSearchAndHop()
    local currentPlayers = getServerPlayerCount(); local maxPlayers = Players.MaxPlayers;
    sendLogMessage(string.format("Start cycle. Players: %d/%d", currentPlayers, maxPlayers))

    if currentPlayers >= maxPlayers then
        sendLogMessage("Server full. Hopping immediately...", "WARN")
        attemptHop("Server full")
        return
    end

    -- Wrap findTargetRift in pcall for extra safety, though errors inside should be caught
    local findSuccess, foundRiftData = pcall(findTargetRift)

    if not findSuccess then
        sendLogMessage("Error during findTargetRift: " .. tostring(foundRiftData), "ERROR") -- Log the error
        sendLogMessage("Hopping due to search error...")
        attemptHop("Search function error")
        return
    end

    if foundRiftData and type(foundRiftData) == "table" then -- Check if data is valid table
        sendLogMessage("MATCH FOUND! Notifying...")
        sendRiftFoundWebhook(foundRiftData) -- Use the dedicated function
        sendLogMessage("Notification sent (if webhook worked).")
        task.wait(0.5)
        sendLogMessage("Rift found. Hopping immediately...")
        attemptHop("Rift found: " .. (foundRiftData.DisplayName or "Unknown"))
    else
        sendLogMessage("No matching rift found. Hopping...")
        attemptHop("No matching rift found")
    end
end


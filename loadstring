        if shouldSearch then SelectedIslands[riftName] = true end
    end
    local selectedCount = 0; for _ in pairs(SelectedIslands) do selectedCount = selectedCount + 1 end
    if selectedCount == 0 then warn("No rifts selected in the script settings!"); return nil end
    print("Searching for", selectedCount, "selected rift types...")
    print(string.format("Filter Settings: Any=%s, 5x=%s, 10x=%s, 25x=%s, OrAbove=%s, MinTime=%ds",
        tostring(SearchMultiplierAny), tostring(SearchMultiplier5x), tostring(SearchMultiplier10x), tostring(SearchMultiplier25x), tostring(SearchMultiplierOrAbove), MINIMUM_RIFT_TIME_SECONDS))

